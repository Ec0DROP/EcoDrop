{
  "info": {
    "name": "EcoDrop API",
    "description": "Full CRUD flow for /donations and /claims. Run the folders in order with the Collection Runner against a freshly started server. expires_at values must be in the future on the day you test. See docs/api-endpoints.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "donationId",
      "value": ""
    },
    {
      "key": "secondDonationId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Donations",
      "item": [
        {
          "name": "List donations (empty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test(\"empty\", () => pm.expect(body).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/donations"
          }
        },
        {
          "name": "Create donation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test(\"available\", () => pm.expect(body.status).to.eql('available'));",
                  "pm.collectionVariables.set('donationId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/donations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor_name\": \"Green Market\",\n  \"food_name\": \"Wholegrain bread\",\n  \"quantity\": 12.5,\n  \"unit\": \"kg\",\n  \"expires_at\": \"2026-12-01T18:00:00Z\",\n  \"pickup_address\": \"ul. Lucerny 15, Warszawa\"\n}"
            }
          }
        },
        {
          "name": "Create second donation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.text() ? pm.response.json() : null;",
